{
  "expo": {
    "name": "PrecisionTrack",
    "slug": "precision_track_mobile",
    "owner": "mrcoder.420",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "precisiontrackmobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PrecisionTrack uses GPS to show your exact location on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PrecisionTrack uses GPS in the background to track your route even when the app is minimized."
      }
    },
    "android": {
      "package": "com.mrcoder420.precisiontrack",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForArcGISOverlayWeAreUsingArcGISTilesAnyway123"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#0a0a1a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PrecisionTrack uses GPS to track your route.",
          "locationAlwaysPermission": "PrecisionTrack uses GPS in the background.",
          "locationWhenInUsePermission": "PrecisionTrack uses GPS to show your location."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a1a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac2769f8-7491-4e20-a40c-473f63b4eec1"
      }
    }
  }
}
