{
  "expo": {
    "name": "PrecisionTrack",
    "slug": "precision_track_mobile",
    "owner": "mrcoder.420",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/summit-logo.jpg",
    "scheme": "precisiontrackmobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/summit-logo.jpg",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PrecisionTrack uses GPS to show your exact location on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PrecisionTrack uses GPS in the background to track your route even when the app is minimized."
      }
    },
    "android": {
      "package": "com.mrcoder420.precisiontrack",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForArcGISOverlayWeAreUsingArcGISTilesAnyway123"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0a0a1a",
        "foregroundImage": "./assets/images/summit-logo.jpg"
      },
      "notification": {
        "icon": "./assets/images/summit-logo.jpg",
        "color": "#fc4c02"
      },

      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PrecisionTrack uses GPS to track your route.",
          "locationAlwaysPermission": "PrecisionTrack uses GPS in the background.",
          "locationWhenInUsePermission": "PrecisionTrack uses GPS to show your location.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/summit-logo.jpg",
          "imageWidth": 300
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac2769f8-7491-4e20-a40c-473f63b4eec1"
      }
    }
  }
}
